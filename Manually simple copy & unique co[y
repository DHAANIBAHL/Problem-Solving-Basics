# Copy list manually
list1 = [10, 25, 30, 45, 50, 80, 10, 30, 90, 10]
list_copy = []

for item in list1:
    list_copy.append(item)

# Unique list copy
unique_copy = []

for item in list1:
    if item not in unique_copy:
        unique_copy.append(item)
    else:
        continue
print(f"Original list: {list1}")
print(f"Copied list: {list_copy}")
print(f"Uniquely copied list: {unique_copy}")
